# ── Amadeus API (机票 + 酒店搜索) ────────────────────────────────────────────
# 注册: https://developers.amadeus.com/register
# 免费 Sandbox 层，足够测试用

AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# "test" = 免费沙盒数据 | "production" = 真实数据（需申请）
AMADEUS_ENV=test

# ── 数据存储 ──────────────────────────────────────────────────────────────────
DB_PATH=./data/holidays.db
CACHE_DIR=./data/cache

# ── 缓存时效（小时）──────────────────────────────────────────────────────────
HOLIDAY_CACHE_TTL_HOURS=168
FLIGHT_CACHE_TTL_HOURS=24
HOTEL_CACHE_TTL_HOURS=24

# ── 搜索默认值 ────────────────────────────────────────────────────────────────
DEFAULT_YEAR=2026
DEPARTURE_AIRPORT=SIN
CURRENCY=SGD
